rules_version = '2';

// Who can use the app: any signed-in account whose email has a document at members/<email>.
// Data rules mirror src/utils/validation.js.
service cloud.firestore {
  match /databases/{database}/documents {

    function isMember() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/members/$(request.auth.token.email));
    }

    function isText(value, max) {
      return value is string && value.size() <= max;
    }

    function hasValidLocation(data) {
      return data.latitude is number && data.latitude >= -90 && data.latitude <= 90
        && data.longitude is number && data.longitude >= -180 && data.longitude <= 180;
    }

    function hasValidTimestamps(data) {
      return data.updatedAt == request.time
        && (resource == null ? data.createdAt == request.time : data.createdAt == resource.data.createdAt);
    }

    function isValidProperty(data) {
      let fields = ['title', 'address', 'latitude', 'longitude', 'rent', 'floor', 'url', 'notes', 'pros', 'cons', 'createdAt', 'updatedAt'];
      return data.keys().hasOnly(fields) && data.keys().hasAll(fields)
        && isText(data.title, 200)
        && isText(data.address, 300)
        && hasValidLocation(data)
        && (data.rent == null || (data.rent is number && data.rent >= 0))
        && (data.floor == null || (data.floor is int && data.floor >= -10 && data.floor <= 300))
        && isText(data.url, 2000) && (data.url == '' || data.url.matches('^https?://.+'))
        && isText(data.notes, 5000)
        && data.pros is list && data.pros.size() <= 100
        && data.cons is list && data.cons.size() <= 100
        && hasValidTimestamps(data);
    }

    function isValidPoint(data) {
      let fields = ['name', 'category', 'notes', 'latitude', 'longitude', 'createdAt', 'updatedAt'];
      return data.keys().hasOnly(fields) && data.keys().hasAll(fields)
        && isText(data.name, 100) && data.name.size() > 0
        && isText(data.category, 100)
        && isText(data.notes, 5000)
        && hasValidLocation(data)
        && hasValidTimestamps(data);
    }

    // Lets the app tell a signed-in user whether they have access. Members are managed in the console only.
    match /members/{email} {
      allow get: if request.auth != null && request.auth.token.email == email;
    }

    match /properties/{id} {
      allow read, delete: if isMember();
      allow create, update: if isMember() && isValidProperty(request.resource.data);
    }

    match /points/{id} {
      allow read, delete: if isMember();
      allow create, update: if isMember() && isValidPoint(request.resource.data);
    }
  }
}
