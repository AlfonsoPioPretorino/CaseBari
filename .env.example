# Copy to .env.local and adjust. Rebuild / restart `npm run dev` after changes.

# --- Firebase (required) ---
# Firebase console → Project settings → General → Your apps → Web app → SDK setup and configuration.
# These values are not secret: access to the data is controlled by firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=

# --- App (optional; defaults target Bari, Italy) ---
VITE_APP_NAME=CaseBari
VITE_CITY_NAME=Bari
# "latitude,longitude"
VITE_CITY_CENTER=41.1171,16.8719
VITE_CITY_ZOOM=13
VITE_CURRENCY=EUR
# e.g. it-IT, en-GB. Empty = browser language.
VITE_LOCALE=

# Map tiles (must allow your usage; keep attribution accurate)
# VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
# VITE_TILE_MAX_ZOOM=19

# OSRM server exposing /routed-foot and /routed-car (FOSSGIS layout)
# VITE_ROUTING_URL=https://routing.openstreetmap.de
# Nominatim-compatible geocoder
# VITE_GEOCODING_URL=https://nominatim.openstreetmap.org
